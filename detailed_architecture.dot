digraph DetailedArchitecture {
    // Graph settings
    graph [rankdir=LR, splines=ortho, nodesep=0.4];
    node [shape=record, style=filled, fontname="Arial", fontsize=9];
    edge [fontname="Arial", fontsize=8];

    // Hardware Layer
    subgraph cluster_hw {
        label="Hardware Layer";
        style=filled;
        color=lightgrey;
        usb_keyboard [label="{USB Keyboard|HID Protocol}", fillcolor=lightcyan, shape=box3d];
        amiga_computer [label="{Amiga Computer|Keyboard Port}", fillcolor=lightcyan, shape=box3d];
        onboard_led [label="{Onboard LED}", fillcolor=lightcyan, shape=component];
    }

    // Main Application Layer
    subgraph cluster_app {
        label="Application Layer (FreeRTOS Tasks)";
        style=filled;
        color=lightblue;

        // Tasks
        subgraph cluster_tasks {
            label="Tasks";
            style=invis;
            usb_task_node [label="{usbKeyboardTask|Prio: Normal|Cycle: 10ms}", fillcolor=pink];
            amiga_task_node [label="{amigaTask|Prio: Low|Cycle: 10ms}", fillcolor=lightgreen];
            led_manager_task_node [label="{LedManagerTask|Prio: Low|Event-Driven}", fillcolor=lightgoldenrodyellow];
            eeprom_task_node [label="{eeprom_task|Prio: Low|Event-Driven}", fillcolor=lightgoldenrodyellow];
        }

        // Queues
        subgraph cluster_queues {
            label="Inter-Task Queues";
            style=invis;
            keyboardQueue [label="{keyboardQueue|16 msgs|keyboard_message_t}", fillcolor=orange, shape=cylinder];
            ledQueue [label="{ledQueue|16 msgs|led_message_t}", fillcolor=orange, shape=cylinder];
            ledManagerQueue [label="{ledManagerQueue|32 msgs|led_manager_message_t}", fillcolor=orange, shape=cylinder];
            amigaTaskQueue [label="{amigaTaskQueue|8 msgs|AmigaTaskMsg_t}", fillcolor=orange, shape=cylinder];
            eepromQueue [label="{eepromQueue|...}", fillcolor=orange, shape=cylinder];
        }
    }

    // Driver Layer
    subgraph cluster_drivers {
        label="Driver & HAL Layer";
        style=filled;
        color=lightyellow;
        usb_host_stack [label="{USB Host Stack|usbh_hid.c}", fillcolor=yellow];
        amiga_protocol [label="{Amiga Protocol Driver|amiga.c}", fillcolor=yellow];
        log_task [label="{Log Task / UART|log_task.c}", fillcolor=yellow];
    }


    // Connections
    // USB Keyboard -> USB Host -> usbTask
    usb_keyboard -> usb_host_stack [label="HID Reports", style=bold];
    usb_host_stack -> usb_task_node [label="Parsed HID Data"];

    // usbTask -> keyboardQueue -> amigaTask
    usb_task_node -> keyboardQueue [label="Posts key events"];
    keyboardQueue -> amiga_task_node [label="Receives key events"];

    // amigaTask -> ledQueue -> usbTask
    amiga_task_node -> ledQueue [label="Posts LED state changes"];
    ledQueue -> usb_task_node [label="Receives LED state"];

    // usbTask -> ledManagerQueue -> ledManagerTask -> Onboard LED
    usb_task_node -> ledManagerQueue [label="Posts status commands"];
    ledManagerQueue -> led_manager_task_node [label="Receives commands"];
    led_manager_task_node -> onboard_led [label="Controls LED GPIO"];

    // amigaTask -> amigaTaskQueue -> amigaTask (self-messaging)
    amiga_task_node -> amigaTaskQueue [label="Posts internal msgs\n(e.g., RESET_START)"];
    amigaTaskQueue -> amiga_task_node [label="Receives internal msgs"];

    // amigaTask -> Amiga Protocol Driver -> Amiga
    amiga_task_node -> amiga_protocol [label="Sends Amiga scancodes"];
    amiga_protocol -> amiga_computer [label="Clock/Data/Reset signals", style=bold];

    // EEPROM Task connections
    amiga_task_node -> eepromQueue [label="Requests save mode"];
    eepromQueue -> eeprom_task_node [label="Receives requests"];

    // Logging connections (conceptual)
    usb_task_node -> log_task [style=dashed, color=grey, label="Logs info"];
    amiga_task_node -> log_task [style=dashed, color=grey, label="Logs info"];
    eeprom_task_node -> log_task [style=dashed, color=grey, label="Logs info"];
}