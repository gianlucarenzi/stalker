digraph ProjectFlowchart {
    // Graph settings
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=9];
    
    // Hardware Layer
    subgraph cluster_hardware {
        label="Hardware Layer";
        style="filled,rounded";
        color=lightgrey;
        
        usb_keyboard [label="USB Keyboard", shape=box3d, fillcolor=lightblue];
        stm32 [label="STM32F401", shape=component, fillcolor=lightgreen];
        amiga_computer [label="Amiga Computer", shape=box3d, fillcolor=lightyellow];
        
        usb_keyboard -> stm32 [label="USB"];
        stm32 -> amiga_computer [label="KBD Port"];
    }
    
    // Software Layer
    subgraph cluster_software {
        label="Software Layer (on STM32)";
        style="filled,rounded";
        color=lightcyan;

        // FreeRTOS Kernel
        scheduler [label="FreeRTOS Scheduler", shape=oval, fillcolor=cyan];

        // Application Tasks
        subgraph cluster_tasks {
            label="Application Tasks";
            style="filled,rounded";
            color=lightsteelblue;
            
            usb_task [label="usbKeyboardTask\n(Prio: Normal)", fillcolor=pink];
            amiga_task [label="amigaTask\n(Prio: Low)", fillcolor=lightgreen];
            led_manager_task [label="LedManagerTask\n(Prio: Low)", fillcolor=lightgoldenrodyellow];
            eeprom_task [label="eeprom_task\n(Prio: Low)", fillcolor=lightgoldenrodyellow];
        }

        // Inter-Task Queues
        subgraph cluster_queues {
            label="Inter-Task Queues";
            style="filled,rounded";
            color=wheat;
            
            keyboard_queue [label="keyboardQueue", shape=cylinder, fillcolor=orange];
            led_queue [label="ledQueue", shape=cylinder, fillcolor=orange];
            led_manager_queue [label="ledManagerQueue", shape=cylinder, fillcolor=orange];
            amiga_task_queue [label="amigaTaskQueue", shape=cylinder, fillcolor=orange];
        }

        // Drivers
        subgraph cluster_drivers {
            label="Drivers / HAL";
            style="filled,rounded";
            color=lightyellow;
            
            usb_host_lib [label="USB Host Lib", fillcolor=yellow];
            amiga_driver [label="Amiga Proto Driver", fillcolor=yellow];
            log_driver [label="Log/UART Driver", fillcolor=yellow];
        }
    }

    // Connections
    // Task -> Scheduler
    scheduler -> usb_task [style=invis];
    scheduler -> amiga_task [style=invis];
    scheduler -> led_manager_task [style=invis];
    scheduler -> eeprom_task [style=invis];

    // USB Flow
    usb_keyboard -> usb_host_lib [ltail=cluster_hardware, lhead=cluster_drivers];
    usb_host_lib -> usb_task [label="HID Data"];
    usb_task -> keyboard_queue [label="Posts key events"];
    
    // Amiga Flow
    keyboard_queue -> amiga_task [label="Receives key events"];
    amiga_task -> amiga_driver [label="Sends Amiga scancodes"];
    amiga_driver -> amiga_computer [ltail=cluster_drivers, lhead=cluster_hardware];

    // LED Feedback Flow (Keyboard LEDs)
    amiga_task -> led_queue [label="Posts LED status"];
    led_queue -> usb_task [label="Receives LED status"];
    usb_task -> usb_host_lib [label="Sets Keyboard LEDs"];

    // Onboard LED Flow
    usb_task -> led_manager_queue [label="Posts status"];
    led_manager_queue -> led_manager_task [label="Receives status"];
    
    // Internal Amiga Task Flow
    amiga_task -> amiga_task_queue [label="Self-posts"];
    amiga_task_queue -> amiga_task;

    // Other connections
    amiga_task -> eeprom_task [label="Saves mode", style=dashed, color=grey];
    usb_task -> log_driver [label="Logs", style=dashed, color=grey];
    amiga_task -> log_driver [label="Logs", style=dashed, color=grey];
}